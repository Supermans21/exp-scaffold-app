# Shopify App Environment Variables
# -------------------------------------------------------------
# Catatan: Saat menjalankan `shopify app dev`, Shopify CLI akan
# secara otomatis mengisi kredensial berikut dari akun Partner Anda.
# File ini berfungsi sebagai template referensi untuk deploy manual/production.
# -------------------------------------------------------------

# Client ID dari aplikasi di Shopify Partner Dashboard
SHOPIFY_API_KEY=a5549e02ffc6871bffe0b5ee575ed261

# Client Secret dari aplikasi di Shopify Partner Dashboard
SHOPIFY_API_SECRET=your_client_secret_here

# Access Scopes yang dibutuhkan oleh aplikasi
SCOPES=write_metaobject_definitions,write_metaobjects,write_products

# URL Tunnel / Host Aplikasi (dibuat otomatis oleh Shopify CLI saat dev)
SHOPIFY_APP_URL=https://your-app-tunnel.trycloudflare.com

# Database URLs untuk Prisma Session Storage (PostgreSQL / Supabase)
# Transaction pooler (port 6543) untuk runtime serverless Vercel:
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler (port 5432) untuk Prisma migrate:
DIRECT_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Node Environment
NODE_ENV=development
